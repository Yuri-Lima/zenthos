  "license": "MIT",
  "scripts": {
    "check": "nx run-many -t typecheck lint test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "worker": "tsx --conditions=@zenthos/source apps/worker/src/main.ts",
    "cli": "tsx --conditions=@zenthos/source apps/cli/src/main.ts",
    "api": "nx run @zenthos/api:serve",
    "studio": "NODE_OPTIONS=--conditions=@zenthos/source langgraphjs dev --no-browser",
    "dashboard": "nx serve @zenthos/dashboard"
  },
  "private": true,
