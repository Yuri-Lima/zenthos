{
  "name": "@zenthos/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zenthos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:client"
    ],
    "targets": {
      "generate": {
        "command": "pnpm nx run @zenthos/api:openapi && openapi-typescript apps/api/openapi.json -o libs/api-client/src/lib/schema.d.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "tslib": "^2.3.0"
  }
}
