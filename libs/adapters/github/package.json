{
  "name": "@zenthos/adapter-github",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zenthos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./live": {
      "@zenthos/source": "./src/live.ts",
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js",
      "default": "./dist/live.js"
    }
  },
  "nx": {
    "tags": [
      "scope:adapter"
    ]
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@zenthos/domain": "workspace:*",
    "@zenthos/ports": "workspace:*",
    "tslib": "^2.3.0"
  }
}
