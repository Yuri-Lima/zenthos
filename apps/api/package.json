{
  "name": "@zenthos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zenthos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:app"
    ],
    "targets": {
      "serve": {
        "command": "SWC_NODE_PROJECT=apps/api/tsconfig.lib.json node --import @swc-node/register/esm-register --conditions=@zenthos/source apps/api/src/main.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "openapi": {
        "command": "SWC_NODE_PROJECT=apps/api/tsconfig.lib.json node --import @swc-node/register/esm-register --conditions=@zenthos/source apps/api/src/scripts/openapi.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@zenthos/adapter-github": "workspace:*",
    "@zenthos/adapter-in-memory": "workspace:*",
    "@zenthos/adapter-postgres": "workspace:*",
    "@zenthos/application": "workspace:*",
    "@zenthos/domain": "workspace:*",
    "@zenthos/ports": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.3.0",
    "zod": "^4.6.6",
    "@zenthos/adapter-temporal": "workspace:*",
    "pg": "^8.23.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
