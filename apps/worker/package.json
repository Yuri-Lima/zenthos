{
  "name": "@zenthos/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zenthos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:app"
    ],
    "targets": {
      "contract": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/contract.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "review": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/review.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "eval-dataset": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/evals.ts dataset",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "eval": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/evals.ts run",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "rotate-key": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/rotate-key.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "prompts-publish": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/prompts.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "coding-agent-trace-check": {
        "command": "tsx --conditions=@zenthos/source apps/worker/src/scripts/coding-agent-trace-check.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@langfuse/client": "5.13.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@zenthos/adapter-claude-code": "workspace:*",
    "@zenthos/adapter-git-sandbox": "workspace:*",
    "@zenthos/adapter-github": "workspace:*",
    "@zenthos/adapter-in-memory": "workspace:*",
    "@zenthos/adapter-langfuse": "workspace:*",
    "@zenthos/adapter-postgres": "workspace:*",
    "@zenthos/adapter-temporal": "workspace:*",
    "@zenthos/agents": "workspace:*",
    "@zenthos/application": "workspace:*",
    "@zenthos/domain": "workspace:*",
    "@zenthos/evals": "workspace:*",
    "@zenthos/ports": "workspace:*",
    "pg": "^8.23.1",
    "tslib": "^2.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@types/pg": "^8.23.1"
  }
}
